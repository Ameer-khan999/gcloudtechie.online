class Var {
	//int id;
	// id=9; we cannot write like this
	short id=32767;
	byte age=23; //[-128 to 127]
	short rank=19323;
	long phone=7396_712_666L; //we can add underscores for our comfort to understand large numbers
	
	float gpa =3.8e4f;
	float gpa1 =3.8888888888888999999999999999f;
	double gpa2 = 3.8888888888888889999999999;
	
	char degree = '\u0042'; // unicodes in java and this statement print char "B" visit https://unicode-table.com
	char degree1 ='B';
	
	//there is only two integer literals they are 1.int literal 2.long literal and short,byte both are not a literals...
	
	//To know the ranges of datatypes
    byte byteminvalue=Byte.MIN_VALUE;
    byte bytemaxvalue=Byte.MAX_VALUE;
	
	short shortminvalue=Short.MIN_VALUE;
    short shortmaxvalue=Short.MAX_VALUE;
	
	int intminvalue=Integer.MIN_VALUE;
    int intmaxvalue=Integer.MAX_VALUE;
	
    long longminvalue=Long.MIN_VALUE;
	long longmaxvalue=Long.MAX_VALUE;

	void compute() {
		//int id;
		//id=9; we can write like this
	    int nextId=id+1;

        System.out.println(id);
		System.out.println(nextId);
		System.out.println(age);
		System.out.println(rank);
		System.out.println(phone);
		System.out.println("degree: " + degree);
	    System.out.println("degree1: " + degree1);
		System.out.println(" ");
        System.out.println("gpa: " + gpa);
		System.out.println("gpa1 of float: " + gpa1);
        System.out.println("gpa2 of double: " + gpa2);
        System.out.println("\nBelow lines are to know the range of datatypes..\n");
		System.out.println("Byte minvalue to maxvalue: " + byteminvalue + " To " + bytemaxvalue);
		System.out.println("Short minvalue to maxvalue: " + shortminvalue + " To " + shortmaxvalue);
		System.out.println("Integer minvalue to maxvalue: " + intminvalue + " To " + intmaxvalue);
		System.out.println("Long minvalue to maxvalue: " + longminvalue + " To " + longmaxvalue);
		




	}
	
	public static void main(String[] args) {
		Var s=new Var();
		s.compute();
	}
}