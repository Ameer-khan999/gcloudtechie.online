	FinalKeyword f3=new FinalKeyword("Shakira","female");
	
	System.out.println("F1 is:" + f1.getName());
	System.out.println("F2 is:" + f2.getName());
	System.out.println("F3 is:" + f3.getName());
	
	System.out.println("F1 is:" + f1.getName());
	System.out.println("F2 is:" + f2.getName());
	System.out.println("F3 is:" + f3.getName());
	}
		
}
