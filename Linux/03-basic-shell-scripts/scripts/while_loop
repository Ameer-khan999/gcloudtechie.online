# Description : This script is to learn about while loop
# Date Modified : 28 June, 2026


# Genrallay if we know end point we can use for loop uis ng count or calculating length of list or any collection.
# so while loop is far different than for as it is using for indefinite loop until condition met true or we can write pre checks while starting program

output=`ls -l helloworld`
while [ $? -eq 0 ]
do
 echo " Yes, helloworld script is there so it is listed and exit code status is 0"
 echo " This is Output and its is success: $output"
 exit 0  # if you remove this exit 0 and it takes you too infine loop until you finish. Press Ctrl + C.
done
