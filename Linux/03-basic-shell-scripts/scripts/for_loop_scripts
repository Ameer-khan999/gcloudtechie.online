
#!/usr/bin/env bash
# Author : Ameer Khan
# Date Created : 28 June, 2026
# Description : This script is to loop the numbers uisng for loop
# Date Modified : 28 June, 2026

echo
number=10
for i in $(seq 1 $number) # you can give {1..10} or in class C syntax too
do
  echo "$i"
done


#Simple for loop output
echo
for i in 1 2 3 4 5
do
  echo "Welcome $i times.."
done

# String loops
echo
for daily_routine in wake exercise eat work sleep
do
  echo "$daily_routine"
done

#Specify days in for loop

echo
i=1
for day in Mon Tue Wed Thu Fri Sat Sun
do
  echo "Day $((i++)) :$day"
done

#List all users one by one from /etc/passwd file
echo
i=1
for username in `awk -F: '{print $1}' /etc/passwd`
do
  echo "Username $((i++)) : $username"
done
